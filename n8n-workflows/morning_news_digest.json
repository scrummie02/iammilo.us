    {
      "id": "format",
      "name": "Format Digest",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        520,
        360
      ],
      "parameters": {
        "jsCode": "const today = new Date().toLocaleDateString('en-US', {weekday:'long', month:'long', day:'numeric'});\n\nfunction getTop(nodeId, n) {\n  try {\n    const items = $(nodeId).all();\n    return items.slice(0, n).map(i => ({\n      title: (i.json.title || '').replace(/[*[\\]]/g, '').trim(),\n      link: i.json.link || ''\n    })).filter(p => p.title);\n  } catch(e) { return []; }\n}\n\nlet msg = '\\u{1F4F0} *News Briefing \\u2014 ' + today + '*\\n\\n';\n\nconst world = getTop('Fox World RSS', 3);\nif (world.length) {\n  msg += '\\u{1F30D} *World* (Fox News)\\n';\n  for (const p of world) msg += `\\u2022 [${p.title}](${p.link})\\n`;\n  msg += '\\n';\n}\n\nconst cnn = getTop('CNN RSS', 2);\nif (cnn.length) {\n  msg += '\\u{1F4FA} *CNN*\\n';\n  for (const p of cnn) msg += `\\u2022 [${p.title}](${p.link})\\n`;\n  msg += '\\n';\n}\n\nconst reuters = getTop('Reuters via Yahoo RSS', 2);\nif (reuters.length) {\n  msg += '\\u{1F4DC} *Reuters / Yahoo World*\\n';\n  for (const p of reuters) msg += `\\u2022 [${p.title}](${p.link})\\n`;\n  msg += '\\n';\n}\n\nconst tech = getTop('Ars Technica RSS', 3);\nif (tech.length) {\n  msg += '\\u{1F4BB} *Tech* (Ars Technica)\\n';\n  for (const p of tech) msg += `\\u2022 [${p.title}](${p.link})\\n`;\n  msg += '\\n';\n}\n\nconst sci = [...getTop('Fox Science RSS', 2), ...getTop('BBC Science RSS', 2)].slice(0, 3);\nif (sci.length) {\n  msg += '\\u{1F52C} *Science*\\n';\n  for (const p of sci) msg += `\\u2022 [${p.title}](${p.link})\\n`;\n  msg += '\\n';\n}\n\nconst npr = getTop('NPR News RSS', 2);\nif (npr.length) {\n  msg += '\\u{1F3A4} *NPR*\\n';\n  for (const p of npr) msg += `\\u2022 [${p.title}](${p.link})\\n`;\n}\n\nif (msg.split('\\n').length < 4) {\n  msg += '\\n_No stories available right now._';\n}\n\nreturn [{ json: { message: msg.trim() } }];"
      },
      "alwaysOutputData": true
    },
