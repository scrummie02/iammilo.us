{
  "name": "Invoice Filer",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "triggerAtHour": 0
            }
          ]
        },
        "triggerInterval": 21600
      },
      "id": "trigger-1",
      "name": "Every 6 Hours",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "authentication": "oAuth2",
        "operation": "getAll",
        "simplifyOutput": true,
        "q": "from:payments-noreply@google.com newer_than:2d",
        "returnAll": false,
        "limit": 10,
        "options": {}
      },
      "id": "gmail-search",
      "name": "Search Billing Emails",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [460, 300],
      "credentials": {
        "gmailOAuth2": {
          "id": "73FQ8r7lzSZjobXf",
          "name": "Gmail account"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "cond-nonzero",
              "leftValue": "={{ $input.first().json.length !== undefined ? $input.first().json.length : 1 }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-msgs",
      "name": "Any Invoices?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "jsCode": "const results = [];\nconst input = $input.all()[0];\nconst msgs = Array.isArray(input.json) ? input.json : [input.json];\nfor (const msg of msgs) {\n  const id = msg.id || msg.messageId;\n  if (id) {\n    results.push({ json: { messageId: id } });\n  }\n}\nreturn results;"
      },
      "id": "loop-emails",
      "name": "Loop Over Messages",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [900, 140]
    },
    {
      "parameters": {
        "authentication": "oAuth2",
        "operation": "addLabels",
        "messageId": "={{ $json.messageId }}",
        "labelIds": ["Label_25"]
      },
      "id": "label-msg",
      "name": "Label as notary_expenses",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [1120, 140],
      "credentials": {
        "gmailOAuth2": {
          "id": "73FQ8r7lzSZjobXf",
          "name": "Gmail account"
        }
      }
    },
    {
      "parameters": {
        "authentication": "oAuth2",
        "operation": "get",
        "messageId": "={{ $json.messageId }}",
        "options": {}
      },
      "id": "get-full-msg",
      "name": "Get Full Message",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [1340, 140],
      "credentials": {
        "gmailOAuth2": {
          "id": "73FQ8r7lzSZjobXf",
          "name": "Gmail account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const results = [];\nfor (const item of $input.all()) {\n  const msg = item.json;\n  const parts = msg.parts || [];\n  function findPdf(partsList) {\n    for (const part of partsList) {\n      if (part.mimeType === 'application/pdf') {\n        const filename = part.filename || 'google-invoice.pdf';\n        const attachmentId = part.body && part.body.attachmentId;\n        if (attachmentId) {\n          results.push({ json: { messageId: msg.id, filename, attachmentId } });\n        }\n      }\n      if (part.parts) findPdf(part.parts);\n    }\n  }\n  findPdf(parts);\n}\nreturn results;"
      },
      "id": "find-pdf",
      "name": "Find PDF Attachment",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1560, 140]
    },
    {
      "parameters": {
        "authentication": "oAuth2",
        "operation": "download",
        "messageId": "={{ $json.messageId }}",
        "attachmentId": "={{ $json.attachmentId }}",
        "options": {}
      },
      "id": "download-pdf",
      "name": "Download PDF",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [1780, 140],
      "credentials": {
        "gmailOAuth2": {
          "id": "73FQ8r7lzSZjobXf",
          "name": "Gmail account"
        }
      }
    },
    {
      "parameters": {
        "operation": "upload",
        "name": "={{ $json.filename }}",
        "parents": ["1QqzqvlokH6i21TIPnZQNMnMzXnl22vF3"],
        "options": {}
      },
      "id": "upload-drive",
      "name": "Upload to Drive Expenses",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [2000, 140],
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "DzN6VZceINJcnOYK",
          "name": "Google Drive account"
        }
      }
    },
    {
      "parameters": {
        "aggregate": "aggregateAllItemData",
        "options": {}
      },
      "id": "aggregate",
      "name": "Aggregate Filenames",
      "type": "n8n-nodes-base.aggregate",
      "typeVersion": 1,
      "position": [2000, 420]
    },
    {
      "parameters": {
        "jsCode": "const allItems = $input.first().json.data || $input.all();\nconst filenames = allItems.map(i => i.filename || i.name || 'invoice.pdf');\nreturn { json: { filenames } };"
      },
      "id": "build-notify",
      "name": "Build Notification List",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2220, 420]
    },
    {
      "parameters": {
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "telegramBotApi",
        "resource": "message",
        "operation": "sendMessage",
        "chatId": 8305133249,
        "text": "=💼 Workspace invoice filed: {{ $json.filenames.join(', ') }} → notary/expenses\\n*(via n8n Invoice Filer)*",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "id": "telegram-notify",
      "name": "Notify Dain via Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [2440, 420],
      "credentials": {}
    },
    {
      "parameters": {},
      "id": "no-op",
      "name": "No Invoices Found",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [900, 460]
    }
  ],
  "connections": {
    "Every 6 Hours": {
      "main": [[{"node": "Search Billing Emails", "type": "main", "index": 0}]]
    },
    "Search Billing Emails": {
      "main": [[{"node": "Any Invoices?", "type": "main", "index": 0}]]
    },
    "Any Invoices?": {
      "main": [
        [{"node": "Loop Over Messages", "type": "main", "index": 0}],
        [{"node": "No Invoices Found", "type": "main", "index": 0}]
      ]
    },
    "Loop Over Messages": {
      "main": [[{"node": "Label as notary_expenses", "type": "main", "index": 0}]]
    },
    "Label as notary_expenses": {
      "main": [[{"node": "Get Full Message", "type": "main", "index": 0}]]
    },
    "Get Full Message": {
      "main": [[{"node": "Find PDF Attachment", "type": "main", "index": 0}]]
    },
    "Find PDF Attachment": {
      "main": [[{"node": "Download PDF", "type": "main", "index": 0}]]
    },
    "Download PDF": {
      "main": [[{"node": "Upload to Drive Expenses", "type": "main", "index": 0}]]
    },
    "Upload to Drive Expenses": {
      "main": [[{"node": "Aggregate Filenames", "type": "main", "index": 0}]]
    },
    "Aggregate Filenames": {
      "main": [[{"node": "Build Notification List", "type": "main", "index": 0}]]
    },
    "Build Notification List": {
      "main": [[{"node": "Notify Dain via Telegram", "type": "main", "index": 0}]]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true,
    "callerPolicy": "workflowsFromSameOwner",
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "all"
  }
}
