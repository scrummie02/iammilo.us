      "parameters": {
        "jsCode": "const emails = $input.all();\nconst VIP_EMAILS = ['julie.a.siegel84@gmail.com', 'jabentley9@gmail.com'];\n\nconst categorized = { VIP: [], Business: [], Personal: [] };\n\nemails.forEach(item => {\n const email = item.json;\n const from = email.from.value || email.from;\n const subject = email.subject || '(No Subject)';\n const entry = `- *${from}*: ${subject}`;\n\n if (VIP_EMAILS.some(vip => from.toLowerCase().includes(vip))) {\n categorized.VIP.push(entry);\n } else if (from.toLowerCase().includes('dainbentley.com') || subject.toLowerCase().includes('notary')) {\n categorized.Business.push(entry);\n } else {\n categorized.Personal.push(entry);\n }\n});\n\nlet message = \"\ud83d\udcec *Email Digest*\\n\\n\";\nif (categorized.VIP.length > 0) message += \"\ud83d\udd34 *VIP (Julie/Jen)*\\n\" + categorized.VIP.join('\\n') + \"\\n\\n\";\nif (categorized.Business.length > 0) message += \"\ud83d\udcbc *Business*\\n\" + categorized.Business.join('\\n') + \"\\n\\n\";\nif (categorized.Personal.length > 0) message += \"\ud83d\udcac *Others*\\n\" + categorized.Personal.join('\\n') + \"\\n\";\nif (emails.length === 0) message = \"\ud83d\udcec No new unread emails.\";\n\nreturn [{ json: { message } }];"
      },
